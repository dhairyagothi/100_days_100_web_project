{
  "name": "100-days-100-web-projects",
  "version": "1.0.0",
  "private": true,
  "description": "A curated open-source collection of 100+ frontend web projects",
  "scripts": {
    "dev": "node server/index.js",
    "dev:static": "npx -y serve . -p 3000",
    "start": "node server/index.js",
    "lint": "npx -y htmlhint index.html contributors/contributor.html",
    "lint:all": "npx -y htmlhint '**/*.html' --ignore 'node_modules/**,**/node_modules/**'",
    "docker:build": "docker build -t 100days-web .",
    "docker:run": "docker run --rm -p 8080:80 100days-web",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dhairyagothi/100_days_100_web_project.git"
  },
  "keywords": [
    "html",
    "css",
    "javascript",
    "web-projects",
    "open-source",
    "frontend"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.19.4",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "validator": "^13.15.26"
  },
  "devDependencies": {
    "serve": "^14.2.6"
  }
}
