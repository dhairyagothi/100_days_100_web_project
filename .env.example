# Example environment variables for local development
# Do NOT commit real secrets. Copy this file to `.env` and fill values.

# Repository info (used by contributors scripts)
REPO_OWNER=dhairyagothi
REPO_NAME=100_days_100_web_project

# Local server port
PORT=3000

# Optional analytics or API keys (store real keys in .env only)
#API_KEY=your_api_key_here

# NODE_ENV (development|production)
NODE_ENV=development
