# MongoDB connection string (required)
MONGODB_URI=mongodb://127.0.0.1:27017/100days_auth

# App URL — used for OAuth callback URLs (no trailing slash)
BASE_URL=http://localhost:3000

# Secrets — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
SESSION_SECRET=replace-with-another-long-random-string

# Google OAuth (optional — omit to disable Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (optional — omit to disable GitHub login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# development | production
NODE_ENV=development

# Server port (local dev only)
PORT=3000
