{
  "manifest_version": 3,
  "name": "Text Saver",
  "description": "Save selected text and its source URL instantly using Alt+S or the right-click context menu.",
  "version": "1.0",

  "permissions": [
    "storage",
    "contextMenus",
    "activeTab"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "View Saved Texts"
  }
}
