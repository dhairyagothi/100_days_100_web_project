{
  "manifest_version": 3,
  "name": "Text Saver Pro",
  "description": "Capture, organize, and highlight text snippets from the web with advanced research tools.",
  "version": "1.1",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Text Saver Pro - Capture & Organize"
  }
}